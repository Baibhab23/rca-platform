# Anthropic Claude API key (required for narrative service)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# JWT secret for gateway authentication
JWT_SECRET=change_me_in_production

# Local service URLs (used by gateway)
INGESTION_URL=http://localhost:8001
ANOMALY_URL=http://localhost:8002
RCA_URL=http://localhost:8003
PRESCRIPTIVE_URL=http://localhost:8004
NARRATIVE_URL=http://localhost:8005
GOVERNANCE_URL=http://localhost:8006

# Infrastructure (local defaults)
DATABASE_URL=postgresql://rca_user:rca_pass@localhost:5432/rca_platform
REDIS_URL=redis://localhost:6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
